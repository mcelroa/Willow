{
  "family": "willow-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::241304351360:role/willowApiExecutionRole",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "containerDefinitions": [
    {
      "name": "willow-api",
      "image": "241304351360.dkr.ecr.eu-west-1.amazonaws.com/willow-api:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
        { "name": "ClientUrl", "value": "https://willow-health.pro" },
        { "name": "CORS_ORIGIN", "value": "https://willow-health.pro" },
        { "name": "Resend__FromEmail", "value": "noreply@willow-health.pro" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:eu-west-1:241304351360:parameter/willow/DATABASE_URL" },
        { "name": "Jwt__Key", "valueFrom": "arn:aws:ssm:eu-west-1:241304351360:parameter/willow/Jwt__Key" },
        { "name": "Resend__ApiKey", "valueFrom": "arn:aws:ssm:eu-west-1:241304351360:parameter/willow/Resend__ApiKey" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/willow-api",
          "awslogs-region": "eu-west-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
